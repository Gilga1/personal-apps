# NVIDIA NIM
NVIDIA_API_KEY=nvapi-your-key-here
VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
VISION_BASE_URL=https://integrate.api.nvidia.com/v1
VISION_ENABLE_THINKING=false

# Notion — Meals DB under Habit Tracker Home
# https://www.notion.so/45a56aaa1c6a441ab6f82b01ac9ca2b7
NOTION_API_KEY=secret_...
NOTION_MEALS_DATABASE_ID=45a56aaa1c6a441ab6f82b01ac9ca2b7

# Server
HOST=0.0.0.0
PORT=8000
# Comma-separated origins for production (e.g. https://thaliscan-web.onrender.com)
CORS_ORIGINS=*
MAX_UPLOAD_MB=10

# Frontend build-time (Render sets this automatically via render.yaml)
# VITE_API_BASE=https://thaliscan-api.onrender.com
