# Device auth (required for watch/API clients)
DEVICE_API_TOKEN=change-me-to-a-long-random-token

# Gemini (Google AI)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Notion — same integration as ThaliScan; must share Habit Tracker
NOTION_API_KEY=
NOTION_HABIT_TRACKER_DATABASE_ID=d5ed17f21d704755b028066c8e8d93e2
NOTION_HABIT_TRACKER_DATA_SOURCE_ID=bd13c6c6-ca63-4ac6-8d55-75ac013b278b

# Storage: leave empty for local SQLite; set for Postgres
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/wear_apps
DATABASE_URL=

# Defaults
TIMEZONE=Asia/Kolkata
CORS_ORIGINS=*
HOST=0.0.0.0
PORT=8001

# Personal defaults for ambiguous quantities
DEFAULT_GLASS_ML=250
AUTO_CREATE_DAILY_ROW=true
CONFIRMATION_THRESHOLD=0.75
AUTO_ACCEPT_THRESHOLD=0.95
